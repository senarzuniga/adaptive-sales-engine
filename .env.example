# Copy this file to .env and fill in your Supabase credentials.
# Never commit the .env file – it is listed in .gitignore.

# ── Frontend (Vite) variables ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>
VITE_SUPABASE_PROJECT_ID=<your-project-id>

# ── Server-side / CLI scripts (regeneration, migrations, etc.) ────────────
# Same URL as above but without the VITE_ prefix (required by ts-node scripts)
SUPABASE_URL=https://<your-project-id>.supabase.co
# Service role key – found in Supabase dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
